UNB_LOG_LEVEL=ERROR
UNB_LOG_TIMEZONE=America/Boise

UNB_DATABASE_PROVIDER=mongodb

UNB_MONGODB_URI=mongodb://unb:devpassword@localhost:27017/unb?authSource=admin
UNB_MONGODB_DB_NAME=unb
UNB_MONGODB_PREFIX=

UNB_MYSQL_HOST=localhost
UNB_MYSQL_PORT=3306
UNB_MYSQL_USER=root
UNB_MYSQL_PASSWORD=password
UNB_MYSQL_DB=unb
UNB_MYSQL_PREFIX=

UNB_CACHE_METHOD=memory
UNB_CACHE_REDIS_HOST=127.0.0.1
UNB_CACHE_REDIS_PORT=6379
UNB_CACHE_REDIS_AUTH=false
UNB_CACHE_REDIS_AUTH_USERNAME=
UNB_CACHE_REDIS_AUTH_PASSWORD=
UNB_CACHE_REDIS_TLS=false

UNB_BASE_URL=http://localhost:3000
UNB_SERVER_PORT=3000

UNB_COOKIE_HTTP_ONLY=true
UNB_COOKIE_SECURE=false
UNB_COOKIE_PATH=/
UNB_COOKIE_DOMAIN=
UNB_COOKIE_MAX_AGE_SECONDS=7200
UNB_COOKIE_SAME_SITE=Lax

UNB_SESSION_SECRET=devonly1234567890abcdefghijklmnopqrstivwxyz
UNB_SESSION_COOKIE_HTTP_ONLY=true
UNB_SESSION_COOKIE_SECURE=false
UNB_SESSION_COOKIE_MAX_AGE_SECONDS=360000
UNB_SESSION_COOKIE_NAME=connect.sid